{
  "name": "smartoffice-core-api",
  "version": "0.1.0",
  "private": true,
  "description": "SmartOffice core API - Node.js/TypeScript backend serving the frontend build and REST API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate:up": "node-pg-migrate up -m src/db/migrations -j js",
    "migrate:down": "node-pg-migrate down -m src/db/migrations -j js",
    "typecheck": "tsc --noEmit",
    "create-admin": "tsx src/scripts/create-admin.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@hubspot/api-client": "^11.1.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.0.0",
    "node-pg-migrate": "^7.6.0",
    "nodemailer": "^6.9.15",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
