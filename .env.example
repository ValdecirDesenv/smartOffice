POSTGRES_PASSWORD=changeme

# Random secret used to sign session cookies. Generate one with:
#   openssl rand -hex 32
SESSION_COOKIE_SECRET=changeme

# Absolute base URL used to build links in emails (password reset, invites). Set this to the
# real public URL once the Cloudflare Tunnel is live (e.g. https://smartoffice.yourdomain.com).
PUBLIC_BASE_URL=http://localhost:8090

# Optional: leave unset to skip sending real emails (forgot-password/invite links are logged to
# the server console instead). To actually send: create a Gmail App Password (requires 2-Step
# Verification enabled on the account) and set both of these.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: leave unset to disable the HubSpot employee sync (POST /api/hubspot/sync-employees
# returns a clear error instead). A HubSpot Private App token with HubDB read access.
HUBSPOT_ACCESS_TOKEN=
