POSTGRES_PASSWORD=changeme

# Random secret used to sign session cookies. Generate one with:
#   openssl rand -hex 32
SESSION_COOKIE_SECRET=changeme

# Absolute base URL used to build links in emails (password reset, invites). Set this to the
# real public URL once the Cloudflare Tunnel is live (e.g. https://smartoffice.yourdomain.com).
PUBLIC_BASE_URL=http://localhost:8090

# Named Cloudflare Tunnel token (Zero Trust dashboard > Networks > Tunnels). The tunnel's
# Public Hostname route must already point at http://core-api:8080. Leave unset to fall back
# to nothing running (the cloudflared service will fail to start) - this project no longer
# uses the free, random-URL Quick Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: leave unset to skip sending real emails (forgot-password/invite links are logged to
# the server console instead). To actually send: create a Gmail App Password (requires 2-Step
# Verification enabled on the account) and set both of these.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: leave unset to disable the HubSpot employee sync (POST /api/hubspot/sync-employees
# returns a clear error instead). A HubSpot Private App token with HubDB read access.
HUBSPOT_ACCESS_TOKEN=

# Optional: leave unset to disable the MDM desk-location collector endpoint (POST
# /api/ingestion/mosyle returns a clear error instead). Shared secret the collector script
# (mosyle/collect-desk-info.sh) must send as X-Collector-Token. Generate one with:
#   openssl rand -hex 32
MDM_COLLECTOR_TOKEN=

# Optional, time-boxed: an ISO date (e.g. 2026-10-16). While set and in the future, a
# never-before-seen monitor or desktop reported by the MDM collector is trusted and
# registered directly at the logged-in user's current desk assignment - no manual
# pre-registration or per-device approval needed. Meant for the initial fleet rollout only;
# unset it (or let the date pass) once that's done so later moves go back through the normal
# review flow instead of being auto-trusted.
MDM_BOOTSTRAP_UNTIL=
